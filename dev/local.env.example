# Copy to dev/local.env and fill in values from the private operations runbook.
TEO_AUTH_REPOSITORY=git@github.com:your-account/your-private-auth-repository.git
TEO_AUTH_BRANCH=teo-dev
TEO_TRAEFIK_CONTAINER=your-local-traefik-container
TEO_PROXY_NETWORK=your-local-proxy-network
TEO_CA_VOLUME=your-local-ca-volume
TEO_CERT_RESOLVER=your-local-certificate-resolver
TEO_PRODUCTION_SSH=user@production-host
TEO_PRODUCTION_MAP_CONTAINER=production-map-storage-container
TEO_LOCAL_MAP_CONTAINER=teo-dev-map-storage-1
