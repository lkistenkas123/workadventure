# Copy this file to .env.dev. Never put production credentials in this file.

DOMAIN=teo.docker
TZ=Europe/Amsterdam
RESTART_POLICY=unless-stopped
LOG_LEVEL=INFO

SECRET_KEY=change-me-local-secret
ROOM_API_SECRET_KEY=change-me-local-room-secret
ADMIN_API_TOKEN=change-me-local-admin-token
ADMIN_API_URL=
ADMIN_URL=https://teo.docker
START_ROOM_URL=/~/office/the-everywhere-office.wam

DISABLE_ANONYMOUS=true
ENABLE_TUTORIAL=false
ENABLE_CHAT=false
ENABLE_CHAT_UPLOAD=false
ENABLE_CHAT_ONLINE_LIST=true
ENABLE_CHAT_DISCONNECTED_LIST=true
UPLOAD_MAX_FILESIZE=10M
CLIENT_DISCONNECTION_RETENTION_MS=60000
PRESENCE_NOTIFICATION_SECRET=change-me-local-presence-secret
PRESENCE_NOTIFICATION_ROOM_URL=https://teo.docker/~/office/the-everywhere-office.wam
PRESENCE_NOTIFICATION_COOLDOWN_SECONDS=300

OPENID_CLIENT_ID=teo-dev
OPENID_CLIENT_SECRET=change-me-local-oidc-secret
OPENID_CLIENT_ISSUER=https://auth.teo.docker
OPENID_PROFILE_SCREEN_PROVIDER=openid
OPENID_SCOPE=openid email profile
OPENID_PROMPT=login
OPENID_USERNAME_CLAIM=email
OPENID_LOCALE_CLAIM=locale
OPENID_LOGOUT_REDIRECT_URL=https://teo.docker
OPENID_WOKA_NAME_POLICY=user_input

MAP_STORAGE_AUTHENTICATION_STRATEGY=
MAP_STORAGE_ENABLE_BEARER_AUTHENTICATION=false
MAP_STORAGE_ENABLE_BASIC_AUTHENTICATION=false
MAP_STORAGE_ENABLE_DIGEST_AUTHENTICATION=false
MAP_STORAGE_API_TOKEN=change-me-local-map-token
MAP_STORAGE_AUTHENTICATION_TOKEN=
MAP_STORAGE_AUTHENTICATION_VALIDATOR_URL=
MAP_STORAGE_AUTHENTICATION_USER=
MAP_STORAGE_AUTHENTICATION_PASSWORD=
USE_DOMAIN_NAME_IN_PATH=false

MAP_EDITOR_ALLOWED_USERS=
MAP_EDITOR_ALLOW_ALL_USERS=true
ENABLE_MAP_EDITOR=true
STORE_VARIABLES_FOR_LOCAL_MAPS=true
PLAYER_VARIABLES_MAX_TTL=86400
MINIMUM_DISTANCE=64
GROUP_RADIUS=48
MAX_USERS_FOR_WEBRTC=4
MAX_PER_GROUP=4
MAX_USERNAME_LENGTH=20

TURN_SERVER=
TURN_USER=
TURN_PASSWORD=
TURN_STATIC_AUTH_SECRET=
STUN_SERVER=stun:stun.l.google.com:19302
JITSI_URL=
JITSI_PRIVATE_MODE=false
JITSI_ISS=
SECRET_JITSI_KEY=
BBB_URL=
BBB_SECRET=

UPLOADER_REDIS_HOST=redis
UPLOADER_REDIS_PORT=6379
UPLOADER_REDIS_DB_NUMBER=0

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=

LIVEKIT_HOST=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_RECORDING_S3_ENDPOINT=
LIVEKIT_RECORDING_S3_CDN_ENDPOINT=
LIVEKIT_RECORDING_S3_ACCESS_KEY=
LIVEKIT_RECORDING_S3_SECRET_KEY=
LIVEKIT_RECORDING_S3_BUCKET=
LIVEKIT_RECORDING_S3_REGION=
LIVEKIT_PIXEL_DENSITY=

MATRIX_API_URI=
MATRIX_PUBLIC_URI=
MATRIX_ADMIN_USER=
MATRIX_ADMIN_PASSWORD=
MATRIX_DOMAIN=

SENTRY_DSN_FRONT=
SENTRY_DSN_PUSHER=
SENTRY_DSN_MAPSTORAGE=
SENTRY_DSN_BACK=
SENTRY_RELEASE=teo-dev
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

ENABLE_REPORT_ISSUES_MENU=false
REPORT_ISSUES_URL=
ENABLE_NOTIFICATIONS=false
DISABLE_NOTIFICATIONS=true
SKIP_RENDER_OPTIMIZATIONS=false
DEBUG_MODE=false
BYPASS_PWA=false
FALLBACK_LOCALE=en

KLAXOON_ENABLED=false
KLAXOON_CLIENT_ID=
YOUTUBE_ENABLED=false
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DOCS_ENABLED=false
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SLIDES_ENABLED=false
ERASER_ENABLED=false
EXCALIDRAW_ENABLED=false
CARDS_ENABLED=false
TLDRAW_ENABLED=false
EMBEDDED_DOMAINS_WHITELIST=
EXCALIDRAW_DOMAINS=
GOOGLE_DRIVE_PICKER_CLIENT_ID=
GOOGLE_DRIVE_PICKER_APP_ID=

PROMETHEUS_AUTHORIZATION_TOKEN=
WHITELISTED_RESOURCE_URLS=
FEATURE_FLAG_BROADCAST_AREAS=false
MAX_DISPLAYED_VIDEOS=4
WOKA_SPEED=2

# Required only so Compose can render the disabled production reverse proxy.
DATA_DIR=./.data
HTTP_PORT=18080
HTTPS_PORT=18443
GRPC_PORT=15051
ACME_EMAIL=dev@localhost
